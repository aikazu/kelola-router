# MiniMax API key (for testing passthrough)
MINIMAX_API_KEY=mm_test_replace_me

# Server bind
HOST=127.0.0.1
PORT=20137

# Upstream region (intl | cn)
MINIMAX_REGION=intl

# Optional: SQLCipher encryption-at-rest passphrase (H1).
# When set, the SQLite file is encrypted with AES-256 (via
# better-sqlite3-multiple-ciphers). When unset, the file is plain
# SQLite — backward compatible. Fresh-deploy only: setting this on an
# existing plaintext DB will refuse to start. See README "Security".
# ROUTER_DB_KEY=your-secret-passphrase