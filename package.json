{
  "name": "kelola-router",
  "version": "0.22.1",
  "description": "Local-first API router for MiniMax + Kiro (AWS CodeWhisperer) + CodeBuddy + Notion — provider-prefix routing, multi-account pool, combo fallback, prompt caching, RTK + Caveman compression, live request-flow console, and a built-in dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client && tsc",
    "build:client": "cd client && npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:client": "cd client && npm test",
    "test:watch": "vitest",
    "add-client-key": "tsx scripts/add-client-key.ts",
    "add-account": "tsx scripts/add-account.ts",
    "add-account:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/add-account.ts",
    "seed-models": "tsx scripts/seed-models.ts",
    "seed-models:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/seed-models.ts",
    "seed-kiro-models": "tsx scripts/seed-kiro-models.ts",
    "seed-kiro-models:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/seed-kiro-models.ts",
    "seed-codebuddy-models": "tsx scripts/seed-codebuddy-models.ts",
    "seed-codebuddy-models:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/seed-codebuddy-models.ts",
    "seed-zai-models": "tsx scripts/seed-zai-models.ts",
    "seed-zai-models:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/seed-zai-models.ts",
    "notion-add-account": "tsx scripts/notion-add-account.ts",
    "notion-add-account:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/notion-add-account.ts",
    "seed-notion-models": "tsx scripts/seed-notion-models.ts",
    "seed-notion-models:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/seed-notion-models.ts",
    "seed-all": "npm run seed-models && npm run seed-kiro-models && npm run seed-codebuddy-models && npm run seed-zai-models && npm run seed-notion-models",
    "seed-all:docker": "npm run seed-models:docker && npm run seed-kiro-models:docker && npm run seed-codebuddy-models:docker && npm run seed-zai-models:docker && npm run seed-notion-models:docker",
    "reset": "tsx scripts/reset.ts",
    "reset:docker": "cross-env ROUTER_DB_PATH=./data/router.db tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "hono": "^4.4.0",
    "pino": "^9.2.0",
    "socks-proxy-agent": "^10.0.0",
    "ulid": "^3.0.2",
    "undici": "^8.3.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^20.12.0",
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
