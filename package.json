{
  "name": "kelola-router",
  "version": "0.2.0",
  "description": "Local-first API router for MiniMax — multi-account, auth, RTK, Caveman, dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "add-user": "tsx scripts/add-user.ts",
    "add-account": "tsx scripts/add-account.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.4.0",
    "pino": "^9.2.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^20.12.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}

