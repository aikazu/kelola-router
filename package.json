{
  "name": "kelola-router",
  "version": "0.15.0",
  "description": "Local-first API router for MiniMax — multi-account pool, client keys with per-key usage, RTK, Caveman, dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client && tsc",
    "build:client": "cd client && npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:client": "cd client && npm test",
    "test:watch": "vitest",
    "add-client-key": "tsx scripts/add-client-key.ts",
    "add-account": "tsx scripts/add-account.ts",
    "seed-models": "tsx scripts/seed-models.ts",
    "reset": "tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.4.0",
    "pino": "^9.2.0",
    "socks-proxy-agent": "^10.0.0",
    "ulid": "^3.0.2",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^20.12.0",
    "concurrently": "^10.0.1",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
